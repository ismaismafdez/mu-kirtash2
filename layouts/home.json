{{- /* Índice del buscador: se genera en /index.json */ -}}
{{- $guides := slice -}}
{{- range site.RegularPages -}}
  {{- $guides = $guides | append (dict
      "id" .File.ContentBaseName
      "title" .Title
      "description" .Description
      "category" .Section
      "seasons" (partial "seasons-of.html" .)
      "tags" (.Params.tags | default (slice))
      "status" (.Params.status | default "demo")
      "url" .RelPermalink) -}}
{{- end -}}
{{- $cats := slice -}}
{{- range hugo.Data.categories -}}
  {{- $cats = $cats | append (dict "id" .id "label" .label "singular" .singular "color" .color "icon" (partial "icon.html" (dict "name" .icon))) -}}
{{- end -}}
{{- dict "guides" $guides "categories" $cats "seasons" hugo.Data.seasons | jsonify -}}
